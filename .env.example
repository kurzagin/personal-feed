# ==============================================================================
# Cloudflare R2 Storage Configuration (Optional: defaults to .local_storage if unset)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=personal-feed-encrypted

# ==============================================================================
# End-to-End Encryption Master Key Configuration
# ==============================================================================
# Master passphrase used with scrypt to derive the 256-bit AES-GCM Master Key
APP_MASTER_PASSPHRASE=change_me_to_a_long_secure_passphrase

# Unique salt constant for master key derivation (minimum 16 characters)
APP_MASTER_SALT=change_me_to_a_unique_random_salt_constant

# ==============================================================================
# Server, Network Security & Database Settings
# ==============================================================================
# Bind strictly to loopback (127.0.0.1) for local-only private usage
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=personal_feed.db

# Optional: Require a local API token on /api/* requests (useful if binding to LAN/VPN)
# LOCAL_API_TOKEN=

# Optional: Set to 1 to disable 3rd-party vxtwitter.com fallback during X/Twitter URL imports
# DISABLE_VXTWITTER_FALLBACK=0
